{
  "manifest_version": 3,
  "name": "Display LinkedIn Post Date and Time",
  "version": "2.5",
  "description": "Replace LinkedIn's relative times with the exact date and time on posts, comments and job postings.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": ["date-settings.js", "linkedin-ids.js", "linkedin-jobs.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Exact post dates"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "author": "Marcos Maciel",
  "homepage_url": "https://www.marcosmaciel.tech"
}
